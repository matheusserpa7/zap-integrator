APP_NAME=ZAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

ADMIN_EMAIL=
ADMIN_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zap
DB_USERNAME=zap
DB_PASSWORD=zap

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=zap
REVERB_APP_KEY=zap-local-reverb-key
REVERB_APP_SECRET=zap-local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8000
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MESSAGING_DRIVER=evolution
WEBHOOK_FAKE_DELIVERY=false

EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_BASE_URL=http://nginx
EVOLUTION_CONNECT_TIMEOUT=3
EVOLUTION_REQUEST_TIMEOUT=10
EVOLUTION_WEBHOOK_SECRET_HEADER=X-ZAP-Evolution-Secret
EVOLUTION_WEBHOOK_MAX_PAYLOAD_BYTES=2097152
INSTANCE_RECONCILIATION_RECENT_MINUTES=360

WEBHOOK_TIMEOUT=10
WEBHOOK_CONNECT_TIMEOUT=3
WEBHOOK_MAX_RETRIES=7
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_RETRY_JITTER_SECONDS=5
# Local Compose may allow http:// to host-gateway test sinks.
# WEBHOOK_ALLOW_HTTP=true
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

MEDIA_DISK=media
MEDIA_PATH=media

RETENTION_INBOX_DAYS=90
RETENTION_MEDIA_DAYS=7
RETENTION_WEBHOOK_PAYLOAD_DAYS=7
RETENTION_IDEMPOTENCY_HOURS=24

QUOTA_MAX_INSTANCES_PER_WORKSPACE=1
MAX_INSTANCES_PER_WORKSPACE=1

RATE_LIMIT_PUBLIC_API=60
RATE_LIMIT_PUBLIC_API_WORKSPACE=120
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=zap_live_

INERTIA_SSR_ENABLED=false
